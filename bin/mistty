#!/bin/sh
# Mistral Vibe under Writ. Vibe reads its whole config from VIBE_HOME, so the hooks.toml
# that scripts/bootstrap-vibe.sh writes there governs these sessions only. Plain `vibe`
# with ~/.vibe stays ungoverned.
VIBE_HOME="${MISTTY_HOME:-$HOME/.mistty}"
export VIBE_HOME
# The writ-* hooks govern these sessions, so Mistty's native gates stay off. With both
# armed, the native work-mode gate refused the model's own `writ mode set` (MTY-139).
VIBE_NATIVE_GOVERNANCE_ENABLED=false
export VIBE_NATIVE_GOVERNANCE_ENABLED
# $0 is the ~/.local/bin link, so resolve it.
root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
# Claude Code puts the plugin's bin/ on the Bash tool's PATH, and Writ's context tells the
# model to run `writ mode set <mode> <sid>`. Another `writ` on PATH has no mode command.
PATH="$root/bin:$PATH"
export PATH
case "${1:-}" in
    approve|replan|grant|mode)
        # Writ commands, typed as `!mistty <verb>` in a session. The bridge refuses all
        # but mode to the model.
        PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m writ.harness.vibe_user "$@"
        ;;
    ask)
        # The model asking the user to approve Writ's pending gate. The bridge put the
        # question on Mistty's approval card before this ran, and the yes reaches Writ
        # through the bridge's post_tool, so this only reports the call ran.
        echo "mistty: the user answered Writ's approval card."
        exit 0
        ;;
esac
# Launch the Rust thin client: it renders the ccstatusline bottom bar and spawns
# the Python app-server itself. VIBE_APP_SERVER_BIN points it at the installed
# app-server so any cwd works; VIBE_HOME above still governs that backend, which
# inherits this environment.
VIBE_APP_SERVER_BIN="$(command -v vibe-app-server)"
[ -n "$VIBE_APP_SERVER_BIN" ] && export VIBE_APP_SERVER_BIN
exec "${MISTTY_RUST_BIN:-/Users/david.malinen/Documents/laarge/dev/mistty/vibe/cli-rust/target/release/vibe-rs}" "$@"
