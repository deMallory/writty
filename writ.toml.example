# writ.toml.example: copy to writ.toml and fill in the secrets below.
# writ.toml is gitignored so credentials never land in version control.
# On a fresh clone:  cp writ.toml.example writ.toml   then edit the secrets.

[source]
# corpus_dir points `writ import-markdown`, `writ export` and the promotion
# write path at Mistty's shipped rule corpus, whose files are the source of
# the rules (Mistty repo ADR 0022). Set it to the corpus dir of a Mistty
# checkout, absolute:
# corpus_dir = "/path/to/mistty/vibe/core/governance/corpus"
# Unset, every default stays this repo's bible/, which is a generated copy.
# WRIT_CORPUS_DIR overrides this per process.

[neo4j]
uri = "bolt://localhost:7687"
user = "neo4j"
password = "writdevpass"  # local dev default; change for any networked instance

[hnsw]
# cache_dir default is ~/.cache/writ/hnsw (see writ/config.py).
# get_hnsw_cache_dir() expands ~ on read, but prefer an absolute path here.

[logs]
# Default destination for `writ logs backup` when --dest is omitted. Copies the
# compressed archive generations (never live streams) off the log root for
# disaster recovery. A leading ~ is expanded on read (get_logs_backup_dest).
# backup_dest = "~/writ-backups"

[bitbucket]
# Credentials for `writ pr sync` (per-file PR comments). Fill these in writ.toml (untracked).
# email = your Atlassian account email; token = an API token (NOT your password).
# Create a token: https://id.atlassian.com/manage-profile/security/api-tokens
email = ""
token = ""

# Hosts the Bash egress guard may send local data to WITHOUT asking you to confirm
# (writ/config.py get_egress_allow_hosts, read by hooks/scripts/writ-bash-write-gate.sh).
# Compared on host only, port ignored. localhost, 127.0.0.1, ::1, [::1] and $WRIT_HOST
# always pass, so this list is for extras; $WRIT_EGRESS_ALLOW_HOSTS (comma-separated)
# adds to it for one session. Uncomment allow_hosts to use it.
[egress]
# allow_hosts = ["uploads.internal.example", "files.example.com"]

# Ranking preference for human-authored rules over AI-proposed ones
# (writ/config.py get_authority_preference_threshold).
# When two results are within this score gap and the higher one is
# authority="ai-provisional", the human / ai-promoted rule is ranked first.
# 0.0 disables the preference entirely, which is the shipped default: a sweep of
# the 193-query gold set measured no change from enabling it, because the only
# ai-provisional node in the corpus is not reachable from the default semantic
# route (benchmarks/RANKING-LEVERS-2026-08-06.md). Raise it only if you author
# ai-provisional rules that the semantic path actually retrieves.
[retrieval]
authority_preference_threshold = 0.0

# The mode a fresh session gets when no mode is set and the prompt classifies as
# neither work nor investigate (writ/config.py get_default_mode, applied by
# hooks/scripts/writ-rag-inject.sh). One of: conversation, debug, review, work,
# investigate. An unrecognized value falls back to "conversation".
# $WRIT_DEFAULT_MODE overrides it for one session.
[governance]
default_mode = "conversation"
